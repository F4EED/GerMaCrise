# Copiez ce fichier en ".env" puis ajustez si nécessaire.
# Ne commitez jamais un vrai SECRET_KEY.

# Sécurité
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Postgres
POSTGRES_USER=maincourante
POSTGRES_PASSWORD=maincourante_pass
POSTGRES_DB=main_courante

# Ports (hôte)
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5433
VISU_PORT=3080
CARTO_PORT=3081

# URLs côté navigateur (le frontend est exécuté dans le navigateur, pas “dans Docker”)
REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_URL_EXTERNAL=http://localhost:8000

